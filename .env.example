# UniMind AI & AegisOps Configuration

PROJECT_NAME="UniMind AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="unimind-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supports PostgreSQL or SQLite local fallback)
DATABASE_URL="sqlite:///./unimind.db"
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/unimind

# RAG & LLM Settings
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHROMA_PERSIST_DIR="./data/chroma_db"

# AegisOps ML Anomaly Detection Settings
ANOMALY_THRESHOLD=0.70
ISOLATION_FOREST_CONTAMINATION=0.05
